# =============================================================================
# KaizenQ Identity — Environment Configuration (.env.example)
# =============================================================================
# IMPORTANT:
# 1. Duplicate this file and name it `.env` or `.env.local`
# 2. Fill in your project-specific credentials from your Supabase Project Dashboard
# 3. NEVER commit `.env` or `.env.local` to version control.
# =============================================================================

# 1. Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon (Publishable) Key
# Found in: Project Settings -> API -> Project API keys -> anon/public
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Optional: Base Public Application URL (Used for verified QR codes & sharing links)
# Defaults to window.location.origin if omitted
VITE_APP_URL=http://localhost:5174

# 4. YouPI-PG UPI Payment Gateway Configuration
# Mode: 'sandbox' (for local simulation/testing) or 'live' (for production UPI settlement)
VITE_PAYMENT_MODE=sandbox

# Merchant UPI Virtual Payment Address (VPA) where payments are received
VITE_YOUPI_MERCHANT_VPA=merchant@youpi

# YouPI-PG Gateway API Endpoint (optional when using isolated PostgreSQL RPC settlement)
VITE_YOUPI_API_URL=https://gateway.youpi.local

# Webhook Secret (HMAC-SHA256 signature verification key)
# Configure in Supabase Edge Functions or Vault for production webhook verification
VITE_YOUPI_WEBHOOK_SECRET=your-youpi-webhook-secret-here

